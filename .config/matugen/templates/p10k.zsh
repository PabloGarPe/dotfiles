# Generado por matugen a partir del wallpaper. No editar a mano.
# Colores del prompt (Powerlevel10k); lo carga ~/.zshrc después de ~/.p10k.zsh.
# Los verdes/rojos de estado se quedan fijos para que "ok" y "error" se reconozcan siempre.

typeset -g POWERLEVEL9K_OS_ICON_FOREGROUND='{{colors.primary.default.hex}}'
typeset -g POWERLEVEL9K_DIR_FOREGROUND='{{colors.primary.default.hex}}'
typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND='{{colors.on_surface_variant.default.hex}}'
typeset -g POWERLEVEL9K_DIR_ANCHOR_FOREGROUND='{{colors.primary_fixed.default.hex}}'
typeset -g POWERLEVEL9K_VCS_VISUAL_IDENTIFIER_COLOR='{{colors.tertiary.default.hex}}'
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND='{{colors.tertiary.default.hex}}'
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND='{{colors.tertiary.default.hex}}'
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND='#e5c890'
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND='{{colors.on_surface_variant.default.hex}}'
typeset -g POWERLEVEL9K_TIME_FOREGROUND='{{colors.outline.default.hex}}'
typeset -g POWERLEVEL9K_RULER_FOREGROUND='{{colors.outline_variant.default.hex}}'
typeset -g POWERLEVEL9K_MULTILINE_FIRST_PROMPT_GAP_FOREGROUND='{{colors.outline_variant.default.hex}}'
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND='{{colors.primary.default.hex}}'
