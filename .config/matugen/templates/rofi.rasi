/* Generado por matugen a partir del wallpaper. No editar a mano. */
* {
    /* Nombres que usan los temas de adi1090x (launchers/, powermenu/, applets/) */
    background:     {{colors.surface.default.hex}}FF;
    background-alt: {{colors.surface_container_high.default.hex}}FF;
    foreground:     {{colors.on_surface.default.hex}}FF;
    selected:       {{colors.primary.default.hex}}FF;
    active:         {{colors.tertiary.default.hex}}FF;
    urgent:         {{colors.error.default.hex}}FF;

    /* Paleta Material completa, para themes/aurora.rasi */
    m-surface:              {{colors.surface.default.hex}};
    m-surface-glass:        {{colors.surface.default.hex}}D9;
    m-surface-container:    {{colors.surface_container.default.hex}};
    m-surface-high:         {{colors.surface_container_high.default.hex}};
    m-surface-highest:      {{colors.surface_container_highest.default.hex}};
    m-on-surface:           {{colors.on_surface.default.hex}};
    m-on-surface-variant:   {{colors.on_surface_variant.default.hex}};
    m-outline:              {{colors.outline.default.hex}};
    m-outline-variant:      {{colors.outline_variant.default.hex}};
    m-primary:              {{colors.primary.default.hex}};
    m-on-primary:           {{colors.on_primary.default.hex}};
    m-primary-container:    {{colors.primary_container.default.hex}};
    m-on-primary-container: {{colors.on_primary_container.default.hex}};
    m-secondary-container:  {{colors.secondary_container.default.hex}};
    m-on-secondary-container: {{colors.on_secondary_container.default.hex}};
    m-tertiary:             {{colors.tertiary.default.hex}};
    m-error:                {{colors.error.default.hex}};
}
