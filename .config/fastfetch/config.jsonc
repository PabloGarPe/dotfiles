// Generado por matugen a partir del wallpaper. No editar a mano.
// Plantilla: ~/.config/matugen/templates/fastfetch.jsonc
// Avatar: ~/.config/fastfetch/avatar.png (el del tema SDDM six-eyes, recortado en círculo)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/avatar.png",
        "width": 22,
        "height": 11,
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 16 },
        "color": {
            "keys": "#ffb4ac",
            "title": "#ffb4ac",
            "output": "#f1dedc",
            "separator": "#a08c8a"
        },
        "size": { "binaryPrefix": "iec", "ndigits": 1 },
        "bar": { "char": { "elapsed": "■", "total": "■" }, "width": 12, "color": { "total": "#534341", "border": "#a08c8a" } },
        "percent": { "type": ["num", "bar"], "color": { "green": "#e0c38c", "yellow": "#e7bdb8", "red": "#ffb4ab" } }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "custom", "format": "──────────────────────────────────", "outputColor": "#534341" },
        { "type": "os",       "key": "󰣇  Sistema",  "format": "{pretty-name} {arch}" },
        { "type": "kernel",   "key": "  Kernel" },
        { "type": "uptime",   "key": "󰅐  Encendido" },
        { "type": "packages", "key": "󰏖  Paquetes" },
        { "type": "wm",       "key": "  Escritorio" },
        { "type": "shell",    "key": "  Shell" },
        { "type": "terminal", "key": "  Terminal" },
        { "type": "custom", "format": "──────────────────────────────────", "outputColor": "#534341" },
        { "type": "cpu",      "key": "  CPU",       "format": "{name}" },
        { "type": "gpu",      "key": "󰢮  GPU",       "format": "{name}", "hideType": "integrated" },
        { "type": "memory",   "key": "󰍛  Memoria" },
        { "type": "disk",     "key": "󰋊  Disco",     "folders": "/" },
        "break",
        { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
    ]
}
