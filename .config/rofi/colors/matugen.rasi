/* Generado por matugen a partir del wallpaper. No editar a mano. */
* {
    /* Nombres que usan los temas de adi1090x (launchers/, powermenu/, applets/) */
    background:     #0f1416FF;
    background-alt: #252b2dFF;
    foreground:     #dee3e6FF;
    selected:       #89d0edFF;
    active:         #c4c3ebFF;
    urgent:         #ffb4abFF;

    /* Paleta Material completa, para themes/aurora.rasi */
    m-surface:              #0f1416;
    m-surface-glass:        #0f1416E6;
    m-surface-container:    #1b2023;
    m-surface-high:         #252b2d;
    m-surface-highest:      #303638;
    m-on-surface:           #dee3e6;
    m-on-surface-variant:   #c0c8cc;
    m-outline:              #8a9296;
    m-outline-variant:      #40484c;
    m-primary:              #89d0ed;
    m-on-primary:           #003544;
    m-primary-container:    #004d61;
    m-on-primary-container: #b9eaff;
    m-secondary-container:  #354a53;
    m-on-secondary-container: #cfe6f1;
    m-tertiary:             #c4c3eb;
    m-error:                #ffb4ab;
}
