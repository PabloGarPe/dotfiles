/* Generado por matugen a partir del wallpaper. No editar a mano. */
* {
    /* Nombres que usan los temas de adi1090x (launchers/, powermenu/, applets/) */
    background:     #16130bFF;
    background-alt: #2e2a21FF;
    foreground:     #eae1d4FF;
    selected:       #e4c36cFF;
    active:         #adcfadFF;
    urgent:         #ffb4abFF;

    /* Paleta Material completa, para themes/aurora.rasi */
    m-surface:              #16130b;
    m-surface-glass:        #16130bD9;
    m-surface-container:    #231f17;
    m-surface-high:         #2e2a21;
    m-surface-highest:      #39342b;
    m-on-surface:           #eae1d4;
    m-on-surface-variant:   #cfc5b4;
    m-outline:              #989080;
    m-outline-variant:      #4c4639;
    m-primary:              #e4c36c;
    m-on-primary:           #3d2e00;
    m-primary-container:    #584400;
    m-on-primary-container: #ffe08f;
    m-secondary-container:  #51462a;
    m-on-secondary-container: #f2e1bb;
    m-tertiary:             #adcfad;
    m-error:                #ffb4ab;
}
