/* Centro de control — basado en launchers/type-3/style-4 */
@import "~/.config/rofi/launchers/type-3/style-4.rasi"

window {
    location:     north;
    anchor:       north;
    y-offset:     44px;
    width:        460px;
    border-radius: 12px;
}
mainbox {
    children:     [ "message", "listview" ];
    spacing:      15px;
    padding:      20px;
}
message {
    padding:          14px;
    border-radius:    10px;
    background-color: @background-alt;
}
textbox {
    horizontal-align: 0.5;
    markup:           true;
}
listview {
    columns:      3;
    lines:        2;
    flow:         horizontal;
    spacing:      10px;
}
element {
    padding:          14px 6px;
    border-radius:    10px;
    background-color: @background-alt;
}
element-icon { enabled: false; }
element normal.active,
element alternate.active {
    background-color: @background-alt;
    text-color:       @active;
}
element selected.normal,
element selected.active {
    border:           0px;
    background-color: @selected;
    text-color:       @background;
}
