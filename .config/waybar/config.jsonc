// Estilo macOS Sequoia (basado en kamlendras/waybar-macos-sequoia), versión oscura.
// Barra de menú. El dock va aparte (dock.jsonc), lo lanza scripts/dock.sh.
[
    // ───────────── Barra de menú ─────────────
    {
        "name": "menubar",
        "layer": "top",
        "position": "top",
        "height": 28,
        "spacing": 0,

        "modules-left": [
            "custom/launcher",
            "hyprland/window",
            "hyprland/workspaces"
        ],
        "modules-right": [
            "temperature",
            "cpu",
            "memory",
            "network",
            "pulseaudio",
            "tray",
            "custom/power",
            "clock"
        ],

        "custom/launcher": {
            "format": "󰣇",
            "tooltip": false,
            "on-click": "rofi -show drun"
        },

        // Nombre de la app activa, en negrita como en macOS
        "hyprland/window": {
            "format": "{class}",
            "max-length": 24,
            "separate-outputs": true,
            "rewrite": {
                "^$": "Escritorio",
                "^org\\.kde\\.dolphin$": "Dolphin",
                "^kitty$": "Kitty",
                "^[Ll]ibre[Ww]olf$": "LibreWolf",
                "^brave-browser$": "Brave",
                "^[Ss]potify$": "Spotify"
            }
        },

        // Workspaces como entradas de menú, donde macOS pone Archivo/Edición/…
        "hyprland/workspaces": {
            "format": "{id}",
            "persistent-workspaces": {
                "DP-1":     [1, 2, 3, 4, 5],
                "HDMI-A-1": [6, 7, 8, 9, 10]
            },
            "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'",
            "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'"
        },

        "temperature": {
            "format": " {temperatureC}°C",
            "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
            "input-filename": "temp1_input",
            "critical-threshold": 85
        },

        "cpu": {
            "format": " {usage}%",
            "interval": 2,
            "states": { "warning": 70, "critical": 90 }
        },

        "memory": {
            "format": "󰍛 {percentage}%",
            "interval": 5,
            "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
            "states": { "warning": 70, "critical": 90 }
        },

        "network": {
            "format-wifi": "󰖩",
            "format-ethernet": "󰈀",
            "format-disconnected": "󰖪",
            "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
            "tooltip-format-ethernet": "{ifname}\n{ipaddr}"
        },

        "pulseaudio": {
            "format": "{icon}",
            "format-muted": "󰝟",
            "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
            "tooltip-format": "{desc}: {volume}%",
            "on-click": "pavucontrol",
            "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "scroll-step": 5
        },

        "tray": {
            "icon-size": 15,
            "spacing": 10
        },

        "custom/power": {
            "format": "⏻",
            "tooltip": false,
            "on-click": "$HOME/.config/rofi/powermenu/type-3/powermenu.sh"
        },

        // "sáb 31 oct  09:13", como el reloj de macOS
        "clock": {
            "format": "{:%a %d %b  %H:%M}",
            "locale": "es_ES.UTF-8",
            "on-click": "$HOME/.config/rofi/control-center/control-center.sh",
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "calendar": {
                "mode": "month",
                "format": {
                    "months":   "<span color='#FFFFFF'><b>{}</b></span>",
                    "days":     "<span color='#C7C7CC'>{}</span>",
                    "weekdays": "<span color='#86868B'><b>{}</b></span>",
                    "today":    "<span color='#0A84FF'><b><u>{}</u></b></span>"
                }
            }
        }
    }
]
